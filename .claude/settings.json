{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "npm run format && npm run lint && composer run lint",
            "timeout": 60,
            "statusMessage": "Running linters before commit..."
          }
        ]
      }
    ]
  }
}
